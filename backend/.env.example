# Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Session Secret
SESSION_SECRET=your_random_session_secret_here_change_in_production

# JWT Secret
JWT_SECRET=your_random_jwt_secret_here_change_in_production

# Neon PostgreSQL Database
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Claude AI API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub API (optional - increases rate limits)
GITHUB_TOKEN=your_github_personal_access_token_optional
